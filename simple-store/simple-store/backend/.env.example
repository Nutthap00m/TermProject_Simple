# คัดลอกเป็น .env แล้วโหลดก่อนรัน:  set -a; source .env; set +a; go run .
PORT=8080
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
SEED_ON_START=true
# FAKESTORE_URL=https://fakestoreapi.com   (ค่าเริ่มต้น — fakestoreapi.com ไม่ต้องใช้ API Key)
